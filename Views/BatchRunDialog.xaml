<Window x:Class="AutoRegressionVM.Views.BatchRunDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="일괄 실행" Height="650" Width="800"
        WindowStartupLocation="CenterOwner"
        ResizeMode="CanResizeWithGrip">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis"/>
    </Window.Resources>

    <Grid Margin="15">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="160"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- 상단: VM 풀 설정 -->
        <GroupBox Grid.Row="0" Header="VM 풀 설정" Margin="0,0,0,10">
            <Grid Margin="10">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="80"/>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBlock Text="동시 실행 VM 수:" VerticalAlignment="Center" Margin="0,0,10,0"/>
                <TextBox x:Name="txtMaxVMs" Grid.Column="1" Text="4" VerticalAlignment="Center"
                         HorizontalContentAlignment="Center" Padding="5,3"/>
                <TextBlock Grid.Column="2" Text="대" VerticalAlignment="Center" Margin="5,0,20,0"/>
                <TextBlock Grid.Column="3" VerticalAlignment="Center" Foreground="#666" FontSize="11">
                    <Run Text="등록된 VM:"/>
                    <Run x:Name="runVMCount" Text="0"/>
                    <Run Text="대"/>
                </TextBlock>
                <StackPanel Grid.Column="4" Orientation="Horizontal">
                    <Button Content="전체 선택" Click="SelectAllVMs_Click" Padding="10,3" Margin="0,0,5,0"/>
                    <Button Content="전체 해제" Click="DeselectAllVMs_Click" Padding="10,3"/>
                </StackPanel>
            </Grid>
        </GroupBox>

        <!-- 중앙: 시나리오 / VM 선택 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="10"/>
                <ColumnDefinition Width="250"/>
            </Grid.ColumnDefinitions>

            <!-- 시나리오 선택 -->
            <GroupBox Grid.Column="0" Header="실행할 시나리오">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                    </Grid.RowDefinitions>
                    <StackPanel Orientation="Horizontal" Margin="5">
                        <Button Content="전체 선택" Click="SelectAllScenarios_Click" Padding="8,2" Margin="0,0,5,0"/>
                        <Button Content="전체 해제" Click="DeselectAllScenarios_Click" Padding="8,2"/>
                        <TextBlock x:Name="txtSelectedCount" VerticalAlignment="Center" Margin="15,0,0,0"
                                   Foreground="#666" FontSize="11"/>
                    </StackPanel>
                    <ListBox x:Name="lstScenarios" Grid.Row="1" Margin="5"
                             SelectionMode="Multiple"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <CheckBox Content="{Binding Name}" IsChecked="{Binding IsSelected}"
                                          Margin="5,3" Checked="Scenario_CheckChanged" Unchecked="Scenario_CheckChanged">
                                    <CheckBox.ToolTip>
                                        <StackPanel MaxWidth="300">
                                            <TextBlock Text="{Binding Scenario.Description}" TextWrapping="Wrap"/>
                                            <TextBlock Text="{Binding Scenario.Steps.Count, StringFormat='스텝: {0}개'}"
                                                       FontSize="11" Foreground="Gray" Margin="0,3,0,0"/>
                                        </StackPanel>
                                    </CheckBox.ToolTip>
                                </CheckBox>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </Grid>
            </GroupBox>

            <!-- VM 풀 선택 -->
            <GroupBox Grid.Column="2" Header="VM 풀">
                <ListBox x:Name="lstVMPool" Margin="5"
                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                    <ListBox.ItemTemplate>
                        <DataTemplate>
                            <CheckBox IsChecked="{Binding IsSelected}" Margin="5,3"
                                      Checked="VM_CheckChanged" Unchecked="VM_CheckChanged">
                                <StackPanel>
                                    <TextBlock Text="{Binding Name}" FontWeight="SemiBold"/>
                                    <TextBlock Text="{Binding VM.VmxPath}" FontSize="10" Foreground="Gray"
                                               TextTrimming="CharacterEllipsis" MaxWidth="200"/>
                                </StackPanel>
                            </CheckBox>
                        </DataTemplate>
                    </ListBox.ItemTemplate>
                </ListBox>
            </GroupBox>
        </Grid>

        <!-- 진행률 -->
        <Grid Grid.Row="2" Margin="0,10,0,5">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="Auto"/>
            </Grid.ColumnDefinitions>
            <ProgressBar x:Name="progressOverall" Height="22" Maximum="100"/>
            <TextBlock x:Name="txtProgress" Grid.Column="0" HorizontalAlignment="Center"
                       VerticalAlignment="Center" FontSize="11"/>
            <TextBlock x:Name="txtElapsed" Grid.Column="1" VerticalAlignment="Center"
                       Margin="10,0,0,0" Foreground="#666" FontFamily="Consolas"/>
        </Grid>

        <!-- 시나리오별 상태 -->
        <TextBlock Grid.Row="3" Text="실행 상태:" FontWeight="SemiBold" Margin="0,5,0,3"/>
        <ListBox x:Name="lstBatchStatus" Grid.Row="4" Margin="0,0,0,10"
                 FontFamily="Consolas" FontSize="11"
                 ScrollViewer.HorizontalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Grid Margin="3,2">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="22"/>
                            <ColumnDefinition Width="*"/>
                            <ColumnDefinition Width="120"/>
                            <ColumnDefinition Width="80"/>
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="{Binding StatusIcon}" FontSize="14"/>
                        <TextBlock Grid.Column="1" Text="{Binding ScenarioName}" VerticalAlignment="Center"/>
                        <TextBlock Grid.Column="2" Text="{Binding VMName}" VerticalAlignment="Center" Foreground="#666"/>
                        <TextBlock Grid.Column="3" Text="{Binding StatusText}" VerticalAlignment="Center"
                                   HorizontalAlignment="Right">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusText}" Value="성공">
                                            <Setter Property="Foreground" Value="#4CAF50"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusText}" Value="실패">
                                            <Setter Property="Foreground" Value="#f44336"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusText}" Value="실행중">
                                            <Setter Property="Foreground" Value="#2196F3"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <!-- 하단 버튼 -->
        <StackPanel Grid.Row="5" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button x:Name="btnRun" Content="일괄 실행" Click="Run_Click"
                    Padding="20,8" Background="#4CAF50" Foreground="White" FontWeight="Bold"
                    Margin="0,0,10,0"/>
            <Button x:Name="btnCancel" Content="취소" Click="Cancel_Click"
                    Padding="20,8" IsEnabled="False"
                    Background="#f44336" Foreground="White" Margin="0,0,10,0"/>
            <Button Content="닫기" Click="Close_Click" Padding="20,8"/>
        </StackPanel>
    </Grid>
</Window>
